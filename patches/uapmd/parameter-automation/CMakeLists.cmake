find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(uh_parameter_patch "${CMAKE_CURRENT_LIST_DIR}")
set(uh_parameter_output "${CMAKE_CURRENT_BINARY_DIR}/generated/parameter-automation")
set(uh_parameter_source "${UAPMD_DIR}/source/remidy/src")
set(uh_parameter_note "${CMAKE_CURRENT_BINARY_DIR}/generated/clap-note-dialect")
set(uh_parameter_state "${CMAKE_CURRENT_BINARY_DIR}/generated/clap-state-load-error")
file(GLOB uh_parameter_inputs "${uh_parameter_source}/clap/*.cpp" "${uh_parameter_source}/clap/*.hpp"
    "${uh_parameter_source}/vst3/*.cpp" "${uh_parameter_source}/vst3/*.hpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${uh_parameter_inputs}
    "${uh_parameter_patch}/apply.py" "${uh_parameter_patch}/fixed_changes.h")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${uh_parameter_patch}/apply.py"
    "${uh_parameter_source}" "${uh_parameter_note}" "${uh_parameter_state}" "${uh_parameter_output}"
    RESULT_VARIABLE uh_parameter_result OUTPUT_VARIABLE uh_parameter_copies ERROR_VARIABLE uh_parameter_error
    OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT uh_parameter_result EQUAL 0)
    message(FATAL_ERROR "${uh_parameter_error}")
endif()
get_target_property(uh_parameter_sources remidy SOURCES)
foreach(uh_name IN LISTS uh_parameter_copies)
    get_filename_component(uh_basename "${uh_name}" NAME)
    get_filename_component(uh_kind "${uh_name}" DIRECTORY)
    set(uh_count 0)
    foreach(uh_src IN LISTS uh_parameter_sources)
        get_filename_component(uh_srcname "${uh_src}" NAME)
        if(uh_srcname STREQUAL uh_basename AND uh_src MATCHES "(^|/)${uh_kind}[^/]*/")
            if(uh_kind STREQUAL "clap")
                set(uh_expected "${uh_parameter_note}/${uh_basename}")
                if(uh_basename STREQUAL "PluginInstanceCLAP.States.cpp")
                    set(uh_expected "${uh_parameter_state}/${uh_basename}")
                endif()
            else()
                set(uh_expected "${uh_parameter_source}/vst3/${uh_basename}")
            endif()
            if(IS_ABSOLUTE "${uh_src}")
                set(uh_actual "${uh_src}")
            else()
                set(uh_actual "${uh_parameter_source}/../${uh_src}")
            endif()
            cmake_path(NORMAL_PATH uh_actual)
            if(NOT uh_actual STREQUAL uh_expected)
                message(FATAL_ERROR "[parameter-automation] unexpected input ${uh_src}, expected ${uh_expected}; UAPMD revision: see apply.py diagnostics; instructions: ${uh_parameter_patch}/README.md")
            endif()
            list(REMOVE_ITEM uh_parameter_sources "${uh_src}")
            math(EXPR uh_count "${uh_count} + 1")
        endif()
    endforeach()
    if(NOT uh_count EQUAL 1)
        message(FATAL_ERROR "[parameter-automation] expected one ${uh_name}, found ${uh_count}; instructions: ${uh_parameter_patch}/README.md")
    endif()
    list(APPEND uh_parameter_sources "${uh_parameter_output}/${uh_name}")
endforeach()
set_property(TARGET remidy PROPERTY SOURCES "${uh_parameter_sources}")
