find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(uh_scan_patch_dir "${CMAKE_CURRENT_LIST_DIR}")
set(uh_scan_upstream "${UAPMD_DIR}/source/uapmd-plugin-hosting/src/scanner")
set(uh_scan_output "${CMAKE_CURRENT_BINARY_DIR}/generated/scan-tool-data-dir-race")
set(uh_scan_name "PluginScanTool.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${uh_scan_upstream}/${uh_scan_name}" "${uh_scan_patch_dir}/apply.py")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${uh_scan_patch_dir}/apply.py"
    "${uh_scan_upstream}" "${uh_scan_output}"
    RESULT_VARIABLE uh_scan_result ERROR_VARIABLE uh_scan_error OUTPUT_QUIET)
if(NOT uh_scan_result EQUAL 0)
    message(FATAL_ERROR "${uh_scan_error}")
endif()
get_target_property(uh_scan_sources uapmd-plugin-hosting SOURCES)
set(uh_scan_count 0)
foreach(uh_source IN LISTS uh_scan_sources)
    get_filename_component(uh_basename "${uh_source}" NAME)
    if(uh_source MATCHES "(^|/)src/scanner/" AND uh_basename STREQUAL uh_scan_name)
        list(REMOVE_ITEM uh_scan_sources "${uh_source}")
        math(EXPR uh_scan_count "${uh_scan_count} + 1")
    endif()
endforeach()
if(NOT uh_scan_count EQUAL 1)
    execute_process(COMMAND git -C "${UAPMD_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE uh_scan_revision OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT uh_scan_revision)
        set(uh_scan_revision "unknown")
    endif()
    message(FATAL_ERROR "[scan-tool-data-dir-race] target: ${uh_scan_upstream}/${uh_scan_name}; expected one uapmd-plugin-hosting source, found ${uh_scan_count}; UAPMD revision: ${uh_scan_revision}; instructions: ${uh_scan_patch_dir}/README.md")
endif()
list(APPEND uh_scan_sources "${uh_scan_output}/${uh_scan_name}")
set_property(TARGET uapmd-plugin-hosting PROPERTY SOURCES "${uh_scan_sources}")
